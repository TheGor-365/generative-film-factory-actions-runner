{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wave2PrivateGateManifestV01",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "manifest_id",
    "schema_version",
    "control_repository",
    "control_main_sha",
    "frozen_private_source_sha",
    "content_hash_semantics",
    "authoritative_merge_set",
    "members",
    "closed_membership",
    "reverse_authority",
    "execution_authority"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "manifest_id": {
      "const": "WAVE2_PRIVATE_GATE_MANIFEST_V01"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "control_repository": {
      "const": "TheGor-365/generative-film-factory-control-center"
    },
    "control_main_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "frozen_private_source_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "content_hash_semantics": {
      "const": "SHA256_CANONICAL_MEMBER_BINDING_EXCLUDING_CONTENT_SHA256_V01"
    },
    "authoritative_merge_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "W2A",
        "W2B",
        "W2C",
        "W2D",
        "W2E",
        "W2F",
        "W2G"
      ],
      "properties": {
        "W2A": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        },
        "W2B": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        },
        "W2C": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        },
        "W2D": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        },
        "W2E": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        },
        "W2F": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        },
        "W2G": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    },
    "members": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lane_id",
          "contract_id",
          "schema_version",
          "repository",
          "merge_sha",
          "path",
          "git_blob_sha",
          "content_sha256",
          "artifact_class",
          "required_for_gate"
        ],
        "properties": {
          "lane_id": {
            "enum": [
              "W2A",
              "W2B",
              "W2C",
              "W2D",
              "W2E",
              "W2F",
              "W2G"
            ]
          },
          "contract_id": {
            "type": "string",
            "minLength": 1
          },
          "schema_version": {
            "type": "string",
            "minLength": 1
          },
          "repository": {
            "const": "TheGor-365/generative-film-factory-control-center"
          },
          "merge_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "git_blob_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "artifact_class": {
            "type": "string",
            "minLength": 1
          },
          "required_for_gate": {
            "const": true
          }
        }
      }
    },
    "closed_membership": {
      "const": true
    },
    "reverse_authority": {
      "const": false
    },
    "execution_authority": {
      "const": false
    }
  }
}
