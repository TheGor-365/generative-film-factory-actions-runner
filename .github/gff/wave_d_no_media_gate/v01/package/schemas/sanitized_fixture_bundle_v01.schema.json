{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SanitizedFixtureBundleV01",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "bundle_id",
    "schema_version",
    "classification",
    "records",
    "contains_private_material",
    "contains_media_bytes",
    "contains_provider_responses",
    "contains_secrets"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "bundle_id": {
      "const": "SANITIZED_FIXTURE_BUNDLE_V01"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "classification": {
      "const": "SANITIZED_SYNTHETIC_NO_MEDIA"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fixture_id",
          "story_placeholder",
          "q0_placeholder",
          "structural_metadata",
          "zero_media",
          "expected_validation_outcome"
        ],
        "properties": {
          "fixture_id": {
            "type": "string",
            "minLength": 1
          },
          "story_placeholder": {
            "type": "string",
            "pattern": "^SYNTHETIC_STORY_PLACEHOLDER_[0-9]+$"
          },
          "q0_placeholder": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "media_present",
              "production_media"
            ],
            "properties": {
              "kind": {
                "const": "Q0_PLACEHOLDER"
              },
              "media_present": {
                "const": false
              },
              "production_media": {
                "const": false
              }
            }
          },
          "structural_metadata": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "profile_id",
              "sequence_count",
              "scene_count",
              "shot_count",
              "generation_segment_count",
              "frame_rate",
              "raster"
            ],
            "properties": {
              "profile_id": {
                "type": "string",
                "minLength": 1
              },
              "sequence_count": {
                "type": "integer",
                "minimum": 1
              },
              "scene_count": {
                "type": "integer",
                "minimum": 1
              },
              "shot_count": {
                "type": "integer",
                "minimum": 1
              },
              "generation_segment_count": {
                "type": "integer",
                "minimum": 1
              },
              "frame_rate": {
                "type": "string",
                "minLength": 1
              },
              "raster": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "zero_media": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "media_asset_count",
              "media_bytes_present",
              "external_asset_locators"
            ],
            "properties": {
              "media_asset_count": {
                "const": 0
              },
              "media_bytes_present": {
                "const": false
              },
              "external_asset_locators": {
                "type": "array",
                "maxItems": 0
              }
            }
          },
          "expected_validation_outcome": {
            "const": "PASS"
          }
        }
      }
    },
    "contains_private_material": {
      "const": false
    },
    "contains_media_bytes": {
      "const": false
    },
    "contains_provider_responses": {
      "const": false
    },
    "contains_secrets": {
      "const": false
    }
  }
}
